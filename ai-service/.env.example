# Copy to .env and fill in real values before deploying outside local dev.

ENVIRONMENT=development
PORT=8000

# Must match server/.env's AI_SERVICE_KEY - this is the shared secret that
# restricts the AI microservice to calls from the Node gateway.
SERVICE_KEY=dev-insecure-service-key-change-me

# "operator_transcript" (default) trusts the transcript text passed in by
# the caller. "whisper_local" activates real speech-to-text via
# faster-whisper (already an installed dependency) - just uncomment both
# lines below. WHISPER_MODEL_PATH can be a size faster-whisper downloads and
# caches automatically on first use ("tiny"/"base"/"small"/"medium"/
# "large-v3" - "small" is a reasonable CPU balance), or a path to
# pre-downloaded weights. See app/engines/speech_engine.py for why this
# isn't the default everywhere (this sandbox's egress policy blocks the
# model-weight host, so it can't be exercised end-to-end from here - it
# works on a machine with normal internet access, e.g. local dev).
STT_PROVIDER=operator_transcript
# STT_PROVIDER=whisper_local
# WHISPER_MODEL_PATH=small

# Alternative to whisper_local: AI4Bharat's IndicConformer, an Indian-
# language-specific ASR model via NVIDIA NeMo instead of Whisper. Real,
# disclosed limitation: unlike Whisper, IndicConformer is one checkpoint
# PER language, so this supports exactly one configured language per
# deployment (not automatic language detection) - see the
# IndicConformerProvider class docstring in app/engines/speech_engine.py
# for that tradeoff and why nemo_toolkit[asr] is a much heavier, more
# install-finicky dependency than faster-whisper. Install with
# `uv sync --extra indic-asr`.
# STT_PROVIDER=indic_conformer
# INDIC_CONFORMER_MODEL_NAME=ai4bharat/indicconformer_stt_hi_hybrid_ctc_rnnt_large
# INDIC_CONFORMER_LANGUAGE=hi

# Optional: real-language-understanding pass for narratives that describe
# something severe without any lexicon keyword (see app/engines/llm_engine.py
# for the full honesty notes). Unset by default - costs real money per call
# and adds a real external dependency, so this is a deliberate deployment
# choice, not a silent default. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# NARRATIVE_LLM_MODEL=claude-haiku-4-5-20251001

# Free, local, no-API-key alternative/complement to the LLM pass above (see
# app/engines/semantic_engine.py) - catches paraphrases the keyword lexicon
# misses via embedding similarity rather than exact wording. ON by default
# (no cost/key gate) - downloads a ~220MB multilingual model automatically
# on first use (needs real internet access, same situation as
# WHISPER_MODEL_PATH above). Uncomment to turn it off, e.g. on a memory-
# constrained deployment or one with restricted network access.
# DISABLE_SEMANTIC_ANALYSIS=true

# Opt-in Indic-to-English translation (see app/engines/translation_engine.py)
# for narratives in Indian languages OUTSIDE the NLP lexicon's 8-language
# coverage (English, Hindi, Bengali, Marathi, Telugu, Tamil, Kannada, Odia) -
# e.g. Punjabi, Gujarati, Malayalam, Assamese, Urdu, Nepali. Off by default:
# unlike the semantic engine above, this needs transformers+torch, a real
# new heavy dependency not used anywhere else in this service, and downloads
# the ai4bharat/indictrans2-indic-en-dist-200M model (~200M params) on first
# use - same "needs real internet access" situation as WHISPER_MODEL_PATH.
# ENABLE_INDIC_TRANSLATION=true

# Opt-in, EXPERIMENTAL native-language semantic matching via IndicBERT (see
# app/engines/indic_semantic_engine.py) - compares a narrative in Hindi,
# Bengali, Marathi, Telugu, Tamil, Kannada, or Odia directly against the
# lexicon's OWN native-language reference phrases, instead of routing
# through English like the semantic engine above. Off by default for a
# STRONGER reason than dependency weight alone: IndicBERT was not
# fine-tuned for sentence-similarity, so this signal's real usefulness is
# genuinely unproven - read that file's docstring caveat before enabling.
# Shares the same `uv sync --extra indic-nlp` install as the translation
# flag above.
# ENABLE_INDIC_BERT_SEMANTIC=true
