# Copy to .env and fill in real values before deploying outside local dev.

ENVIRONMENT=development
PORT=8000

# Must match server/.env's AI_SERVICE_KEY - this is the shared secret that
# restricts the AI microservice to calls from the Node gateway.
SERVICE_KEY=dev-insecure-service-key-change-me

# "operator_transcript" (default) trusts the transcript text passed in by
# the caller. "whisper_local" activates LocalWhisperProvider, which needs
# `faster-whisper` installed and WHISPER_MODEL_PATH pointed at local model
# weights - see app/engines/speech_engine.py for why this isn't the default
# in this environment.
STT_PROVIDER=operator_transcript
# WHISPER_MODEL_PATH=/path/to/local/whisper/weights
