# Copy to .env and fill in real values before deploying outside local dev.

NODE_ENV=development
PORT=4000

# SQLite locally; swap to a postgresql:// URL (and datasource provider in
# schema.prisma) to migrate to PostgreSQL with no other code changes.
DATABASE_URL="file:./data/traumasense.db"

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-key-in-production

CORS_ORIGINS=http://localhost:5173,http://localhost:5183

STORAGE_ROOT=./storage

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=dev-insecure-service-key-change-me

GOV_EMAIL_DOMAINS=.gov.in,.nic.in,.police.gov.in

# true (default) echoes the OTP code in the API response body since no SMS
# gateway is configured. Set false once SMS_PROVIDER credentials are added
# to notification.service.ts's adapters.
OTP_DEV_MODE=true
